rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin GLOBAL do sistema (quem criou/mantém o app) — NÃO tem relação
    // nenhuma com ser dono de uma viagem (trips/{id}.ownerId). Campo
    // `isAdmin` em users/{uid}, igual ao isAdmin() do CashZ — mas diferente
    // de lá, aqui o client NUNCA pode gravar `isAdmin` (fora da whitelist de
    // campos da regra de users abaixo), só setável manualmente no Firebase
    // Console (sem backend próprio pra automatizar isso).
    function isGlobalAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function role(tripId) {
      return tripData(tripId).roles[request.auth.uid];
    }

    function isParticipant(tripId) {
      return isSignedIn() && request.auth.uid in tripData(tripId).participants;
    }

    function canEdit(tripId) {
      return isSignedIn() && role(tripId) in ['OWNER', 'EDITOR'];
    }

    function ghostsOf(data) {
      return 'ghosts' in data ? data.ghosts : {};
    }

    // Resgate de convite: antes de entrar numa viagem por link, o usuário grava
    // trip_joins/{tripId}_{uid} provando que conhece um convite VÁLIDO daquela
    // viagem (ver regra de trip_joins abaixo). O auto-join em trips exige esse
    // doc existir e com o mesmo papel — saber só o tripId não basta mais, e o
    // papel não pode ser maior que o do convite.
    function hasJoinClaim(tripId, uid, role) {
      let path = /databases/$(database)/documents/trip_joins/$(tripId + '_' + uid);
      return exists(path) && get(path).data.role == role;
    }

    // Campos novos de despesa (status de compra e código/link da reserva):
    // tipo e tamanho validados em create e update. Chave ausente passa — despesa
    // anterior a essa feature não tem esses campos.
    function expenseFieldsValid(d) {
      return (!('purchased' in d) || d.purchased is bool)
        && (!('bookingRef' in d) || (d.bookingRef is string && d.bookingRef.size() <= 300));
    }

    // Update de despesa por owner/editor: revalida só o que MUDOU (diff). Um
    // update parcial — ex.: marcar `purchased` numa despesa antiga sem `date` —
    // não é reprovado por campo que ele nem toca. tripId é imutável (senão uma
    // despesa poderia ser movida pra outra viagem em que o usuário também edita).
    function expenseUpdateValid(tripId) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return !('tripId' in changed)
        && (!('amountBRL' in changed) || (d.amountBRL is number && d.amountBRL > 0))
        && (!('participants' in changed) || (d.participants is list && d.participants.size() > 0))
        && (!('paidBy' in changed) || d.paidBy in tripData(tripId).participants)
        && (!('date' in changed) || (d.date is string && d.date.size() > 0))
        && expenseFieldsValid(d);
    }

    // Mesma ideia pra acerto: só revalida o que mudou. from/to são checados
    // campo a campo (o outro lado pode ser um fantasma antigo, já fora de
    // participants, e isso não deve travar uma edição que nem o toca).
    function settlementUpdateValid(tripId) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return !('tripId' in changed)
        && (!('amount' in changed) || (d.amount is number && d.amount > 0))
        && (!('from' in changed) || d.from in tripData(tripId).participants)
        && (!('to' in changed) || d.to in tripData(tripId).participants);
    }

    // Espelha o isPlanActive() do CashZ: nunca confia só no campo `plan`
    // sincronizado, sempre recalcula a expiração contra o horário da própria
    // escrita. `plan`/`planExpiresAt` em users/{uid} só são escritos pelo
    // Admin SDK do CashZ (ver regra de users abaixo) — nunca pelo client.
    function isCashzPremium(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path)
        && get(path).data.plan in ['premium', 'annual']
        && (!('planExpiresAt' in get(path).data) || get(path).data.planExpiresAt == null
            || timestamp.value(get(path).data.planExpiresAt) > request.time);
    }

    match /trips/{tripId} {
      // isGlobalAdmin() além do participante: painel /admin precisa contar
      // e listar viagens pra métricas — sem isso, getCountFromServer(trips)
      // é negado por inteiro (query sem where não bate com a checagem por
      // participante, mesma classe de bug documentada em SECURITY.md).
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isGlobalAdmin());

      allow create: if isSignedIn()
        && isCashzPremium(request.auth.uid)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.roles[request.auth.uid] == 'OWNER';

      allow update: if isSignedIn() && (
        (
          // ownerId só muda pela transferência dedicada (último branch, só o dono
          // atual). Sem esta linha, um EDITOR trocava ownerId pra si mesmo aqui
          // e virava dono de fato (passava a poder transferir e excluir a viagem).
          canEdit(tripId) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.roles[resource.data.ownerId] == 'OWNER' &&
          resource.data.ownerId in request.resource.data.participants
        ) || (
          // Auto-join via link de convite: usuário novo só pode adicionar a si mesmo
          !(request.auth.uid in resource.data.participants) &&
          request.resource.data.participants == resource.data.participants.concat([request.auth.uid]) &&
          request.resource.data.roles[request.auth.uid] in ['EDITOR', 'VIEWER'] &&
          hasJoinClaim(tripId, request.auth.uid, request.resource.data.roles[request.auth.uid]) &&
          request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'roles'])
        ) || (
          // Sair da viagem: qualquer participante (exceto o dono) pode remover a si
          // mesmo, opcionalmente deixando um fantasma (ghost_*) no lugar para
          // preservar o histórico de despesas/dívidas já vinculado ao seu uid.
          request.auth.uid in resource.data.participants &&
          request.auth.uid != resource.data.ownerId &&
          !(request.auth.uid in request.resource.data.participants) &&
          !(request.auth.uid in request.resource.data.roles) &&
          request.resource.data.participants.size() <= resource.data.participants.size() &&
          request.resource.data.participants.size() >= resource.data.participants.size() - 1 &&
          resource.data.participants.hasOnly(request.resource.data.participants.concat([request.auth.uid])) &&
          request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
          ghostsOf(resource.data).diff(ghostsOf(request.resource.data)).affectedKeys().size() <= 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'roles', 'ghosts'])
        ) || (
          // Transferir dono: só o dono atual pode ceder, só pra alguém que já
          // é participante. O dono antigo vira EDITOR (não perde acesso, só
          // o rótulo) — participants não muda, só ownerId e o role dos dois
          // uids envolvidos.
          request.auth.uid == resource.data.ownerId &&
          request.resource.data.ownerId != resource.data.ownerId &&
          request.resource.data.ownerId in resource.data.participants &&
          request.resource.data.roles[request.resource.data.ownerId] == 'OWNER' &&
          request.resource.data.roles[resource.data.ownerId] == 'EDITOR' &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([resource.data.ownerId, request.resource.data.ownerId]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'roles'])
        )
      );

      // Só o dono exclui a viagem — editor gerencia despesas e membros, mas não
      // apaga a viagem inteira (destrutivo e irreversível).
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /expenses/{expenseId} {
      allow read: if isParticipant(resource.data.tripId);
      // Antes só checava permissão, não o conteúdo — uma escrita direta (bug
      // futuro num componente, ou devtools) conseguia gravar amountBRL
      // negativo/zero ou participants vazio, corrompendo o saldo calculado
      // (computeTripBalances) pra viagem inteira, silenciosamente. paidBy
      // não precisa estar em `participants` (pagar por alguém sem dividir é
      // um caso real de uso, ver AddExpenseDialog.tsx), só precisa ser
      // alguém da viagem.
      allow create: if canEdit(request.resource.data.tripId)
        && request.resource.data.amountBRL is number && request.resource.data.amountBRL > 0
        && request.resource.data.participants is list && request.resource.data.participants.size() > 0
        && request.resource.data.paidBy in tripData(request.resource.data.tripId).participants
        && request.resource.data.date is string && request.resource.data.date.size() > 0
        && expenseFieldsValid(request.resource.data);
      allow delete: if canEdit(resource.data.tripId);
      allow update: if (canEdit(resource.data.tripId) && expenseUpdateValid(resource.data.tripId)) || (
        // Sair da viagem: o próprio participante troca seu uid por um fantasma
        // nesta despesa (como pagador e/ou como divisor), sem alterar mais nada.
        isParticipant(resource.data.tripId) &&
        (resource.data.paidBy == request.auth.uid || request.auth.uid in resource.data.participants) &&
        (resource.data.paidBy == request.auth.uid
          ? (request.resource.data.paidBy != request.auth.uid && request.resource.data.paidBy in request.resource.data.participants)
          : request.resource.data.paidBy == resource.data.paidBy) &&
        !(request.auth.uid in request.resource.data.participants) &&
        request.resource.data.participants.size() == resource.data.participants.size() &&
        resource.data.participants.hasOnly(request.resource.data.participants.concat([request.auth.uid])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidBy', 'participants'])
      );
    }

    match /activities/{activityId} {
      allow read: if isParticipant(resource.data.tripId);
      allow create: if canEdit(request.resource.data.tripId);
      allow update, delete: if canEdit(resource.data.tripId);
    }

    // Carteira de câmbio — planejamento pessoal, privado (só o próprio dono
    // vê; owner/editor da viagem só no caso de um fantasma, que não tem
    // login pra gerenciar a própria). Sem update: lote errado é apagado e
    // recriado (ver services/currencyLots.ts).
    function isGhostUid(uid) {
      return uid.matches('ghost_.*');
    }

    // Compartilhamento mútuo de carteira (casal viajando junto, dinheiro
    // unificado) — declaração unilateral (wallet_shares), só vira "mútuo"
    // (libera leitura cruzada) quando existem os dois sentidos pro mesmo
    // tripId. Doc ID determinístico (`${tripId}_${fromUid}_${toUid}`) pra
    // exists() ser barato — nunca uma query dentro da regra.
    function walletShareDocId(tripId, fromUid, toUid) {
      return tripId + '_' + fromUid + '_' + toUid;
    }
    function hasMutualWalletShare(tripId, uidA, uidB) {
      return exists(/databases/$(database)/documents/wallet_shares/$(walletShareDocId(tripId, uidA, uidB)))
          && exists(/databases/$(database)/documents/wallet_shares/$(walletShareDocId(tripId, uidB, uidA)));
    }

    match /currency_lots/{lotId} {
      allow read: if resource.data.ownerUid == request.auth.uid
        || (canEdit(resource.data.tripId) && isGhostUid(resource.data.ownerUid))
        || hasMutualWalletShare(resource.data.tripId, request.auth.uid, resource.data.ownerUid);
      allow create: if request.resource.data.ownerUid == request.auth.uid
        || (canEdit(request.resource.data.tripId) && isGhostUid(request.resource.data.ownerUid));
      allow delete: if resource.data.ownerUid == request.auth.uid
        || (canEdit(resource.data.tripId) && isGhostUid(resource.data.ownerUid));
    }

    match /wallet_shares/{shareId} {
      allow read: if resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid;
      allow create: if request.resource.data.fromUid == request.auth.uid
        && isParticipant(request.resource.data.tripId)
        && request.resource.data.toUid in tripData(request.resource.data.tripId).participants;
      allow delete: if resource.data.fromUid == request.auth.uid;
    }

    match /users/{uid} {
      // `get` (um doc por uid) segue liberado pra qualquer logado — useUserProfiles
      // precisa resolver nome/foto dos membros. `list` (varrer a coleção inteira)
      // fica só pro admin global: antes, qualquer logado conseguia baixar e-mail e
      // plano de TODOS os usuários do app com um getDocs(collection('users')).
      // Agora é preciso já conhecer o uid (que só aparece em viagens em comum).
      allow get: if isSignedIn();
      allow list: if isGlobalAdmin();

      // `plan`/`planExpiresAt`/`planSyncedAt` (status de plano sincronizado
      // do CashZ) nunca podem ser escritos pelo client — só o Admin SDK do
      // CashZ escreve esses campos (bypassa regra). O client só mexe no
      // próprio perfil.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'photoBase64']);

      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'photoBase64']);
    }

    match /settlements/{settlementId} {
      allow read: if isParticipant(resource.data.tripId);
      // Owner/editor pode registrar acerto entre QUAISQUER dois participantes
      // da viagem, não só envolvendo o próprio uid — é exatamente o caso de
      // "marcar como pago" no modal de despesa (o editor cobre a dívida de
      // outra pessoa em nome dela). Só `to == request.auth.uid` (removido)
      // bloquearia esse fluxo. Mesmo raciocínio de expenses pro resto: nada
      // validava `amount`/`from`/`to` antes — um acerto de valor negativo/
      // zero, ou de alguém que nem está na viagem, corrompia o saldo calculado.
      allow create: if canEdit(request.resource.data.tripId)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.from in tripData(request.resource.data.tripId).participants
        && request.resource.data.to in tripData(request.resource.data.tripId).participants;
      allow delete: if canEdit(resource.data.tripId);
      allow update: if (canEdit(resource.data.tripId) && settlementUpdateValid(resource.data.tripId)) || (
        // Sair da viagem: o próprio participante troca seu uid por um fantasma
        // neste acerto (como quem pagou e/ou como quem recebeu).
        isParticipant(resource.data.tripId) &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) &&
        (resource.data.from == request.auth.uid ? request.resource.data.from != request.auth.uid : request.resource.data.from == resource.data.from) &&
        (resource.data.to == request.auth.uid ? request.resource.data.to != request.auth.uid : request.resource.data.to == resource.data.to) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['from', 'to'])
      );
    }

    match /ai_threads/{threadId} {
      // Só o backend (Admin SDK, api/ai/chat.ts) cria/edita conteúdo — cliente
      // só lê a própria conversa. Igual ao padrão de users/{uid} pra
      // plan/planExpiresAt: conteúdo gerado por processo controlado, nunca
      // aceito direto do client — exceto "arquivar" (esconder da lista), que
      // é só um campo booleano do próprio dono, mesmo padrão de
      // diff().affectedKeys().hasOnly([...]) usado em trips/expenses/settlements.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow create, delete: if false;
    }

    match /ai_messages/{messageId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /ai_usage/{docId} {
      // Contador global de custo — nunca legível/gravável pelo client.
      allow read, write: if false;
    }

    match /client_logs/{logId} {
      // Erro não tratado (render ou promise/window) reportado direto do
      // client pro admin conseguir ver sem depender do usuário reportar
      // manualmente (ver docs/LOGGING.md). Cada um só grava o próprio erro,
      // autoatribuído — nunca em nome de outro uid, nunca lido/apagado por
      // quem não seja o admin global.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isGlobalAdmin();
      allow update: if false;
    }

    match /invites/{inviteId} {
      // Leitura por qualquer logado: o próprio ID (imprevisível, tipo token) já
      // é o segredo — precisa saber o ID exato pra ler, não dá pra listar/adivinhar.
      allow read: if isSignedIn();
      allow create: if canEdit(request.resource.data.tripId);
      allow update, delete: if false;
    }

    // Resgate de convite — prova de que o usuário conhece um convite válido da
    // viagem. Doc ID determinístico `${tripId}_${uid}` (a regra de trips confere
    // por caminho, sem query). create/update (re-resgate com outro convite) só
    // passam se o convite informado EXISTE, é daquela viagem e tem exatamente o
    // papel declarado — então ninguém declara EDITOR com um convite de VIEWER.
    // Sem delete: o doc é inofensivo parado (só vale junto de um convite real).
    match /trip_joins/{joinId} {
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['tripId', 'inviteId', 'role', 'uid'])
        && request.resource.data.keys().hasOnly(['tripId', 'inviteId', 'role', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tripId is string
        && request.resource.data.inviteId is string
        && request.resource.data.role in ['EDITOR', 'VIEWER']
        && joinId == request.resource.data.tripId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.tripId == request.resource.data.tripId
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
