rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function role(tripId) {
      return tripData(tripId).roles[request.auth.uid];
    }

    function isParticipant(tripId) {
      return isSignedIn() && request.auth.uid in tripData(tripId).participants;
    }

    function canEdit(tripId) {
      return isSignedIn() && role(tripId) in ['OWNER', 'EDITOR'];
    }

    function ghostsOf(data) {
      return 'ghosts' in data ? data.ghosts : {};
    }

    match /trips/{tripId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.roles[request.auth.uid] == 'OWNER';

      allow update: if isSignedIn() && (
        (
          canEdit(tripId) &&
          request.resource.data.roles[resource.data.ownerId] == 'OWNER' &&
          resource.data.ownerId in request.resource.data.participants
        ) || (
          // Auto-join via link de convite: usuário novo só pode adicionar a si mesmo
          !(request.auth.uid in resource.data.participants) &&
          request.resource.data.participants == resource.data.participants.concat([request.auth.uid]) &&
          request.resource.data.roles[request.auth.uid] in ['EDITOR', 'VIEWER'] &&
          request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'roles'])
        ) || (
          // Sair da viagem: qualquer participante (exceto o dono) pode remover a si
          // mesmo, opcionalmente deixando um fantasma (ghost_*) no lugar para
          // preservar o histórico de despesas/dívidas já vinculado ao seu uid.
          request.auth.uid in resource.data.participants &&
          request.auth.uid != resource.data.ownerId &&
          !(request.auth.uid in request.resource.data.participants) &&
          !(request.auth.uid in request.resource.data.roles) &&
          request.resource.data.participants.size() <= resource.data.participants.size() &&
          request.resource.data.participants.size() >= resource.data.participants.size() - 1 &&
          resource.data.participants.hasOnly(request.resource.data.participants.concat([request.auth.uid])) &&
          request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
          ghostsOf(resource.data).diff(ghostsOf(request.resource.data)).affectedKeys().size() <= 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'roles', 'ghosts'])
        )
      );

      allow delete: if canEdit(tripId);
    }

    match /expenses/{expenseId} {
      allow read: if isParticipant(resource.data.tripId);
      allow create: if canEdit(request.resource.data.tripId);
      allow delete: if canEdit(resource.data.tripId);
      allow update: if canEdit(resource.data.tripId) || (
        // Sair da viagem: o próprio participante troca seu uid por um fantasma
        // nesta despesa (como pagador e/ou como divisor), sem alterar mais nada.
        isParticipant(resource.data.tripId) &&
        (resource.data.paidBy == request.auth.uid || request.auth.uid in resource.data.participants) &&
        (resource.data.paidBy == request.auth.uid
          ? (request.resource.data.paidBy != request.auth.uid && request.resource.data.paidBy in request.resource.data.participants)
          : request.resource.data.paidBy == resource.data.paidBy) &&
        !(request.auth.uid in request.resource.data.participants) &&
        request.resource.data.participants.size() == resource.data.participants.size() &&
        resource.data.participants.hasOnly(request.resource.data.participants.concat([request.auth.uid])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidBy', 'participants'])
      );
    }

    match /activities/{activityId} {
      allow read: if isParticipant(resource.data.tripId);
      allow create: if canEdit(request.resource.data.tripId);
      allow update, delete: if canEdit(resource.data.tripId);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
    }

    match /settlements/{settlementId} {
      allow read: if isParticipant(resource.data.tripId);
      allow create: if canEdit(request.resource.data.tripId) && request.resource.data.to == request.auth.uid;
      allow delete: if canEdit(resource.data.tripId);
      allow update: if canEdit(resource.data.tripId) || (
        // Sair da viagem: o próprio participante troca seu uid por um fantasma
        // neste acerto (como quem pagou e/ou como quem recebeu).
        isParticipant(resource.data.tripId) &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid) &&
        (resource.data.from == request.auth.uid ? request.resource.data.from != request.auth.uid : request.resource.data.from == resource.data.from) &&
        (resource.data.to == request.auth.uid ? request.resource.data.to != request.auth.uid : request.resource.data.to == resource.data.to) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['from', 'to'])
      );
    }

    match /invites/{inviteId} {
      // Leitura por qualquer logado: o próprio ID (imprevisível, tipo token) já
      // é o segredo — precisa saber o ID exato pra ler, não dá pra listar/adivinhar.
      allow read: if isSignedIn();
      allow create: if canEdit(request.resource.data.tripId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
